NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Preferred for nightly Sheets backup (never NEXT_PUBLIC_).
# Also required by scripts/load-test-check-in.mjs (loadtest_* RPCs are service-role only).
# SUPABASE_SERVICE_ROLE_KEY=

# Staff PIN — checked only on the server, never shipped to the browser
STAFF_ADMIN_PIN=
STAFF_ACCOUNTING_PIN=
# How many devices may stay logged in at once (oldest kicked). Default admin=1, accounting=2.
# STAFF_ADMIN_MAX_SESSIONS=2
# STAFF_ACCOUNTING_MAX_SESSIONS=2
# Auto logout after N days with no staff activity. Recommended: 2.
# STAFF_SESSION_IDLE_DAYS=2
# Long secret used to mint the internal staff Supabase session (not typed by humans)
# Also used as Sheets backup fallback when SERVICE_ROLE_KEY is not set
STAFF_SUPABASE_PASSWORD=

# Nightly Google Sheets backup (4:00 AM Thai time = 21:00 UTC)
# 1. Create a Google Cloud service account
# 2. Enable Google Sheets API + Google Drive API
# 3. Paste the JSON key — the app creates the spreadsheet via API
#    (or set GOOGLE_SHEETS_SPREADSHEET_ID if you already have one)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Staff emails who can open the backup anytime (comma-separated). Writer so Monthly month picker works.
GOOGLE_SHEETS_SHARE_EMAIL=
# Optional if the app already created the sheet:
# GOOGLE_SHEETS_SPREADSHEET_ID=
# Required in production so only Vercel cron (or you) can trigger backup
CRON_SECRET=

# AI: seed admin bookings from chat screenshots (WhatsApp / Line / etc.)
# Preferred: Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash)
# GEMINI_BOOKING_VISION_MODEL=gemini-3.8-flash
# Optional fallback if Gemini is not set:
# OPENAI_API_KEY=
# OPENAI_BOOKING_VISION_MODEL=gpt-4o-mini
